APP_NAME="Tagihan UKT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL. Port 5433 = port yang dipublikasikan docker compose ke host.
# Di dalam container, docker-compose.yml menimpa DB_HOST=db dan DB_PORT=5432.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=sevima_ukt
DB_USERNAME=sevima
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Password akun demo hasil seeder (hanya untuk lokal).
DEMO_PASSWORD=password

# Secret HMAC per institusi, dikirim panitia lewat email. JANGAN di-commit.
# Nama variabel = HMAC_SECRET_ + kode institusi (non-alfanumerik jadi "_"), lihat config/sevima.php.
HMAC_SECRET_UNIV_A=
HMAC_SECRET_UNIV_B=
HMAC_SECRET_UNIV_C=
